<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/btn_widget_input_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Registrar gasto ou ganho"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription=""
            android:src="@drawable/ic_widget_search"
            android:tint="#9AA0A6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Registrar gasto ou ganho..."
            android:textColor="#9AA0A6"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Registrar por voz"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_widget_mic"
        android:tint="#FFFFFF" />

</LinearLayout>
